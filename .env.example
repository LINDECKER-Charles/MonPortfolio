# ══════════════════════════════════════════════════════════════════════════════
# MonPortfolio — configuration centralisée
#
# Copier ce fichier en `.env` (gitignoré) à la racine et ajuster les valeurs.
# Sans `.env`, chaque consommateur retombe sur les valeurs par défaut (prod).
#
# Deux moments de consommation :
#   [build]   injecté dans le bundle Angular par front-portfolio/scripts/gen-env.mjs
#             (hooks npm prebuild/prestart/pretest/postinstall)
#   [runtime] lu par le serveur SSR (server.mjs) via process.env —
#             `environment:` de compose.yaml (valeurs du .env de l'hôte), dev docker
#   [ci]      aucune variable injectée : gen-env.mjs utilise ses défauts (prod) ;
#             les variables runtime des hôtes servis vivent dans ENV_STAGING / ENV_PROD
# ══════════════════════════════════════════════════════════════════════════════

# ── Identité du site ──────────────────────────────────────────── [build] ─────
# Origine publique canonique (canonical, Open Graph, JSON-LD, robots, sitemap).
SITE_URL=https://charles-lindecker.com

# Préfixe des images statiques du dossier racine images/, servies par le serveur SSR
# sous /img (dev-server Angular inclus) — relatif : chaque environnement sert ses
# propres images, embarquées dans l'image Docker (build-once respecté). Une origine
# http(s) absolue reste acceptée (serveur d'images externe).
IMAGE_SERVER_URL=/img

# ── Serveur SSR ──────────────────────────────────────────────── [runtime] ────
# Port d'écoute du serveur Express (4000 fixé dans l'image ; l'edge Caddy y route).
PORT=4000

# Interface d'écoute. Vide = toutes les interfaces ; 127.0.0.1 recommandé
# derrière un reverse-proxy local ; 0.0.0.0 requis dans un conteneur.
HOST=

# Hosts admis par la garde SSRF d'@angular/ssr, séparés par des virgules.
# Complète (n'écrase pas) build.options.security.allowedHosts d'angular.json.
# Indispensable si le site est servi sous un nouveau domaine sans rebuild.
NG_ALLOWED_HOSTS=

# production sur le VPS (cache le détail des erreurs Express).
NODE_ENV=

# Dossier des images servies sous /img (défaut : ../images relatif au build, /app/images
# dans l'image Docker).
IMAGES_DIR=

# 1 = X-Robots-Tag "noindex, nofollow" sur toutes les réponses (environnement de test).
ROBOTS_NOINDEX=0

# ── Déploiement docker (hôtes servis uniquement) ─────────────── [deploy] ────
# Voir .env.staging.example / .env.prod.example : COMPOSE_PROJECT_NAME, REGISTRY,
# IMAGE_TAG, CADDY_DOMAINS. En dev, compose.override.yaml construit l'image localement.

# ── Dev (docker compose) ──────────────────────────────────────── [dev] ───────
# Port exposé du dev-server Angular.
DEV_PORT=4200
