{
  "name": "front-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "gen:env": "node scripts/gen-env.mjs",
    "postinstall": "node scripts/gen-env.mjs",
    "prestart": "node scripts/gen-env.mjs",
    "prebuild": "node scripts/gen-env.mjs",
    "pretest": "node scripts/gen-env.mjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "lighthouse": "lhci autorun",
    "serve:ssr:front-portfolio": "node dist/front-portfolio/server/server.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "fonts:self-host": "node scripts/self-host-fonts.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"e2e/**/*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"e2e/**/*.ts\" \"scripts/*.mjs\"",
    "lint": "ng lint && npm run lint:css"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=22.18 <25"
  },
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-server": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/ssr": "^22.1.5",
    "@tailwindcss/postcss": "^4.2.2",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "gsap": "^3.14.2",
    "postcss": "^8.5.8",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^24.13.3",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
