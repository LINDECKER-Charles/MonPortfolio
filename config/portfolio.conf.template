<VirtualHost *:80>
    Protocols h2 http/1.1
    ServerName ${APACHE_PROD_DOMAIN}
    ServerAlias www.${APACHE_PROD_DOMAIN}

    # Préserver le host et le protocole
    ProxyPreserveHost On

    RemoteIPHeader X-Forwarded-For
    RemoteIPTrustedProxy 127.0.0.1

    # === CORS ===

    LoadModule headers_module modules/mod_headers.so

    <IfModule mod_headers.c>
        # Autoriser ton front
        Header always set Access-Control-Allow-Origin "https://${APACHE_PROD_DOMAIN}"
        Header always set Access-Control-Allow-Methods "GET,POST,OPTIONS"
        Header always set Access-Control-Allow-Headers "Content-Type,Authorization"
        # CSP stricte : aucun script inline (app Angular prérendue → zéro nonce/hash requis).
        # 'unsafe-inline' conservé uniquement sur style-src (styles composants Angular + attributs style ; faible surface).
        # frame-src : embed vidéo YouTube de la modale projets (sinon retirer pour 'none').
        Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.charles-lindecker.com; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
   </IfModule>

    # Gérer les préflight OPTIONS
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.${APACHE_PROD_DOMAIN}$ [NC]
    RewriteRule ^ https://${APACHE_PROD_DOMAIN}%{REQUEST_URI} [R=301,L]

    # SSR Angular (Node)
    ProxyPass        / http://127.0.0.1:${APACHE_PROD_SSR_PORT}/
    ProxyPassReverse / http://127.0.0.1:${APACHE_PROD_SSR_PORT}/

    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "0"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    ErrorLog ${APACHE_LOG_DIR}/mates_error.log
    CustomLog ${APACHE_LOG_DIR}/mates_access.log combined

    # Redirect HTTP → HTTPS
    RewriteEngine On
RewriteCond %{SERVER_NAME} =www.${APACHE_PROD_DOMAIN} [OR]
RewriteCond %{SERVER_NAME} =${APACHE_PROD_DOMAIN}
RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>
