<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName ${APACHE_IMAGES_DOMAIN}

    DocumentRoot ${APACHE_IMAGES_DOCROOT}

    <Directory ${APACHE_IMAGES_DOCROOT}>
        Options Indexes FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/cards_error.log
    CustomLog ${APACHE_LOG_DIR}/cards_access.log combined
RewriteEngine on
# Some rewrite rules in this file were disabled on your HTTPS site,
# because they have the potential to create redirection loops.

# RewriteCond %{SERVER_NAME} =${APACHE_IMAGES_DOMAIN}
# RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]

SSLCertificateFile /etc/letsencrypt/live/${APACHE_IMAGES_DOMAIN}/fullchain.pem
SSLCertificateKeyFile /etc/letsencrypt/live/${APACHE_IMAGES_DOMAIN}/privkey.pem
Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
</IfModule>
