# Unit systemd du serveur SSR — template versionné (rendu manuel via envsubst).
#
# Variables : SITE_LABEL (ex. "prod"), VPS_DIR (ex. /var/www/portfolio),
#             SERVICE_USER (utilisateur d'exécution).
#
# Rendu (sur le VPS ou localement) :
#   export SITE_LABEL=prod VPS_DIR=/var/www/portfolio SERVICE_USER=<user>
#   envsubst '$SITE_LABEL $VPS_DIR $SERVICE_USER' \
#     < angular-portfolio.service.template \
#     | sudo tee /etc/systemd/system/angular-portfolio.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now angular-portfolio.service
#
# Le runtime est configuré par $VPS_DIR/shared/.env (PORT, HOST, NODE_ENV,
# NG_ALLOWED_HOSTS) — cf. .env.example racine et docs/deploiement.md.

[Unit]
Description=Angular SSR portfolio (${SITE_LABEL})
After=network.target

[Service]
Type=simple
User=${SERVICE_USER}
# `current` est un symlink basculé atomiquement par deploy-ssr.yml ;
# il est résolu au démarrage → chaque restart prend la release active.
WorkingDirectory=${VPS_DIR}/current
ExecStart=/usr/bin/node ${VPS_DIR}/current/dist/front-portfolio/server/server.mjs
EnvironmentFile=${VPS_DIR}/shared/.env
Restart=on-failure
RestartSec=2

# Durcissement minimal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
