<IfModule mod_ssl.c>
<VirtualHost *:443>
    Protocols h2 http/1.1
    ServerName ${SITE_DOMAIN}
    ServerAlias www.${SITE_DOMAIN}

    # Préserver le host et le protocole (le SSR valide le Host via allowedHosts)
    ProxyPreserveHost On

    RemoteIPHeader X-Forwarded-For
    RemoteIPTrustedProxy 127.0.0.1

    <IfModule mod_headers.c>
        Header always set Access-Control-Allow-Origin "https://${SITE_DOMAIN}"
        Header always set Access-Control-Allow-Methods "GET,POST,OPTIONS"
        Header always set Access-Control-Allow-Headers "Content-Type,Authorization"
        # CSP stricte : aucun script inline (app Angular prérendue → zéro nonce/hash requis).
        # 'unsafe-inline' conservé uniquement sur style-src (styles composants Angular + attributs style ; faible surface).
        # frame-src : embed vidéo YouTube de la modale projets (sinon retirer pour 'none').
        Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://${APACHE_IMAGES_DOMAIN}; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        ${SITE_EXTRA_HEADERS}
   </IfModule>

    # Filet pendant un restart du backend : page statique servie par Apache
    # (fichier déployé par deploy-apache.yml vers /var/www/maintenance.html).
    Alias /maintenance.html /var/www/maintenance.html
    ProxyPass /maintenance.html !
    ErrorDocument 502 /maintenance.html
    ErrorDocument 503 /maintenance.html

    # SSR Angular (Node)
    ProxyPass        / http://127.0.0.1:${SITE_SSR_PORT}/
    ProxyPassReverse / http://127.0.0.1:${SITE_SSR_PORT}/

    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "0"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Logs séparés par site : incidents attribuables (prod ≠ test).
    ErrorLog ${APACHE_LOG_DIR}/${SITE_LOG}_error.log
    CustomLog ${APACHE_LOG_DIR}/${SITE_LOG}_access.log combined

SSLCertificateFile /etc/letsencrypt/live/${SITE_DOMAIN}/fullchain.pem
SSLCertificateKeyFile /etc/letsencrypt/live/${SITE_DOMAIN}/privkey.pem
Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
</IfModule>
