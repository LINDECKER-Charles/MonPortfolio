# Dotenv du déploiement PRODUCTION (substitution des variables docker compose sur l'hôte).
# Copier en .env.prod (gitignoré) et compléter. Son contenu est stocké tel quel dans le
# secret GitHub ENV_PROD ; le job de déploiement l'écrit dans ${PROD_PATH}/.env sur le
# serveur avant `docker compose ... up`. Cf. docs/DEVOPS-SECRETS.md.

# --- Projet Compose (isole cet environnement des autres stacks de l'hôte) ---
COMPOSE_PROJECT_NAME=monportfolio-prod

# --- Fichiers compose (TOUTE commande manuelle dans ce dossier doit les respecter) ---
# Sélectionne l'overlay de déploiement et EXCLUT compose.override.yaml (dev) : sans
# cette ligne, un `docker compose up -d` à la main relancerait le dev-server Angular
# sur l'hôte. _deploy.yml l'exporte aussi (défense en profondeur).
COMPOSE_FILE=compose.yaml:compose.deploy.yaml

# --- Registry d'images (GHCR) ---
REGISTRY=ghcr.io/lindecker-charles/monportfolio
IMAGE_TAG=prod

# --- Runtime SSR ---
# charles-lindecker.com est déjà dans angular.json ; www n'y est pas.
NG_ALLOWED_HOSTS=charles-lindecker.com,www.charles-lindecker.com
ROBOTS_NOINDEX=0

# --- Domaines publics (déploiement) — le DNS doit pointer sur l'hôte AVANT ---
# Apex + www (même certificat, même upstream — www était un ServerAlias Apache).
CADDY_DOMAINS=charles-lindecker.com, www.charles-lindecker.com
